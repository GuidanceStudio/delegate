#!/usr/bin/env bash
# delegate: switch delegate mode on or off, and hand code-writing steps to opencode.
set -uo pipefail

STATE_DIR="${DELEGATE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/delegate}"
PROJECT_FLAG=".delegate.on"
CONFIG="${DELEGATE_CONFIG:-$HOME/.config/delegate/config}"
DEFAULT_MODEL="openrouter/deepseek/deepseek-v4.1-flash"
DEFAULT_VARIANT="high"

usage() {
    cat >&2 <<'EOF'
usage: delegate on [--project]   switch on for this session, or for every session on this repo
       delegate off              switch off at both levels
       delegate status           print on (session|project) or off
       delegate hook             UserPromptSubmit hook: reads the hook JSON on stdin
       delegate model [<provider/model> [effort]]
                                 show or choose the executor model and its effort
       delegate run --check "<cmd>" [--resume <session>] <brief-file>
                                 run the executor on the brief, then the check, at the git root
EOF
    exit 2
}

project_root() { git -C "$1" rev-parse --show-toplevel 2>/dev/null || echo "$1"; }

# The session id comes from Claude Code or, failing that, Codex.
session_id() { echo "${CLAUDE_CODE_SESSION_ID:-${CODEX_THREAD_ID:-}}"; }

# Prints "session", "project", "session, project" or nothing.
levels() {
    local session="$1" dir="$2" out=""
    [ -n "$session" ] && [ -f "$STATE_DIR/$session" ] && out="session"
    [ -f "$(project_root "$dir")/$PROJECT_FLAG" ] && out="${out:+$out, }project"
    echo "$out"
}

cmd_on() {
    if ! command -v opencode >/dev/null 2>&1; then
        echo "delegate: opencode is not installed or not on PATH; install it from https://opencode.ai, then retry" >&2
        exit 1
    fi
    if [ "${1:-}" = "--project" ]; then
        local root; root="$(project_root "$PWD")"
        touch "$root/$PROJECT_FLAG"
        echo "delegate mode on for every session in $root"
        return
    fi
    [ -n "${1:-}" ] && usage
    local sid; sid="$(session_id)"
    if [ -z "$sid" ]; then
        echo "delegate: no session id in CLAUDE_CODE_SESSION_ID or CODEX_THREAD_ID; use 'delegate on --project' instead" >&2
        exit 1
    fi
    mkdir -p "$STATE_DIR" && touch "$STATE_DIR/$sid"
    echo "delegate mode on for this session"
}

cmd_off() {
    local sid; sid="$(session_id)"
    [ -n "$sid" ] && rm -f "$STATE_DIR/$sid"
    rm -f "$(project_root "$PWD")/$PROJECT_FLAG"
    echo "delegate mode off"
}

cmd_status() {
    local l; l="$(levels "$(session_id)" "$PWD")"
    if [ -n "$l" ]; then echo "on ($l)"; else echo "off"; fi
}

# A hook must never block the prompt, so every failure path exits 0 silently.
cmd_hook() {
    local input session cwd l
    input="$(cat)"
    session="$(jq -r '.session_id // empty' <<<"$input" 2>/dev/null)" || exit 0
    cwd="$(jq -r '.cwd // empty' <<<"$input" 2>/dev/null)" || exit 0
    [ -n "$cwd" ] && [ -d "$cwd" ] || exit 0
    l="$(levels "$session" "$cwd")"
    [ -n "$l" ] || exit 0
    echo "delegate mode is ON ($l): every step that writes code or tests goes through \`$(cd "$(dirname "$0")" && pwd)/delegate run\`; follow the delegate skill."
}

# Prints the value of one `key=value` line from the config. The config is data,
# so it is read line by line, never sourced.
config_value() {
    local key="$1" line
    [ -f "$CONFIG" ] || return 0
    while IFS= read -r line; do
        case "$line" in
            "$key="*) printf '%s\n' "${line#"$key="}" ;;
        esac
    done < "$CONFIG"
}

# The suggested models and their levels, identical to what opencode reports, so
# choosing one of them never calls opencode.
PRESET_IDS=(
    openrouter/deepseek/deepseek-v4.1-flash
    openrouter/z-ai/glm-5.3-flash
    openrouter/qwen/qwen3.8-flash
)

preset_levels() {
    case "$1" in
        openrouter/deepseek/deepseek-v4.1-flash | openrouter/z-ai/glm-5.3-flash)
            echo "low medium high max" ;;
        openrouter/qwen/qwen3.8-flash)
            echo "high max" ;;
        *) return 1 ;;
    esac
}

# Space-separated levels for a model id: presets first, else the variants
# opencode lists. Prints NOT_LISTED when opencode does not know the model; for
# a listed model with no variants it prints nothing.
model_levels() {
    local id="$1" levels
    if levels="$(preset_levels "$id")"; then echo "$levels"; return; fi
    opencode models --verbose 2>/dev/null \
        | grep -E '^[{}[:space:]]' \
        | jq -rs --arg id "$id" '
            map(select(.providerID + "/" + .id == $id)) as $m
            | if ($m | length) == 0 then "NOT_LISTED"
              else ($m[0].variants // {} | keys_unsorted | join(" "))
              end'
}

# xhigh when the model has it, else high, else nothing.
preferred_effort() {
    case " $1 " in
        *" xhigh "*) echo xhigh ;;
        *" high "*) echo high ;;
    esac
}

cmd_model() {
    local id="${1:-}" effort="${2:-}" p
    if [ -z "$id" ]; then
        resolve_executor
        echo "model: $EXEC_MODEL"
        echo "effort: ${EXEC_VARIANT:-none}"
        echo "presets:"
        for p in "${PRESET_IDS[@]}"; do
            printf '  %s  %s\n' "$p" "$(preset_levels "$p")"
        done
        return
    fi
    local levels; levels="$(model_levels "$id")"
    if [ "$levels" = NOT_LISTED ]; then
        echo "delegate: $id is not listed by opencode; add it to your opencode config first" >&2
        exit 1
    fi
    if [ -n "$effort" ]; then
        case " $levels " in
            *" $effort "*) ;;
            *) echo "delegate: effort $effort not available for $id; choose one of: $levels" >&2; exit 1 ;;
        esac
    else
        effort="$(preferred_effort "$levels")"
    fi
    mkdir -p "$(dirname "$CONFIG")"
    printf 'model=%s\nvariant=%s\n' "$id" "$effort" > "$CONFIG"
    echo "model: $id"
    echo "effort: ${effort:-none}"
    echo "levels: $levels"
}

# Sets EXEC_MODEL and EXEC_VARIANT: environment beats the config, which beats
# the default. The config's variant counts only when it also names a model.
resolve_executor() {
    local cfg_model cfg_variant
    cfg_model="$(config_value model)"
    cfg_variant="$(config_value variant)"
    EXEC_MODEL="${DELEGATE_MODEL:-${cfg_model:-$DEFAULT_MODEL}}"
    if [ -n "${DELEGATE_VARIANT:-}" ]; then
        EXEC_VARIANT="$DELEGATE_VARIANT"
    elif [ -n "$cfg_model" ]; then
        EXEC_VARIANT="$cfg_variant"
    else
        EXEC_VARIANT="$DEFAULT_VARIANT"
    fi
}

# Prints only what the caller needs to decide: the executor's own report
# (bounded), what changed, and a check the executor could not fake. The full
# event log stays on disk for when the summary is not enough.
cmd_run() {
    local check="" resume="" brief=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --check) check="${2:-}"; shift 2 ;;
            --resume) resume="${2:-}"; shift 2 ;;
            -*) usage ;;
            *) brief="$1"; shift ;;
        esac
    done
    if [ -z "$check" ] || [ -z "$brief" ]; then
        echo "delegate run: --check \"<cmd>\" and a brief file are both required" >&2
        exit 2
    fi
    [ -f "$brief" ] || { echo "delegate run: brief file not found: $brief" >&2; exit 2; }

    local root log max="${DELEGATE_MAX_CHARS:-2000}"
    root="$(project_root "$PWD")"
    mkdir -p "$STATE_DIR/runs"
    log="$STATE_DIR/runs/$(date +%Y%m%d-%H%M%S)-$$.jsonl"

    local args=(run --agent delegate-executor --format json --dir "$root")
    resolve_executor
    args+=(--model "$EXEC_MODEL")
    [ -n "$EXEC_VARIANT" ] && args+=(--variant "$EXEC_VARIANT")
    [ -n "$resume" ] && args+=(--session "$resume")
    # opencode run appends piped stdin to the message and waits for EOF, so an
    # inherited stdin that stays open would hang the run.
    (cd "$root" && opencode "${args[@]}" "$(cat "$brief")") < /dev/null > "$log" 2>"$log.stderr"
    local exec_rc=$?

    local summary report
    summary="$(jq -rs '
        (map(.sessionID // empty) | first // "none") as $s
        | (map(select(.type == "step_finish") | .part) ) as $f
        | "session: \($s)\ncost: $\($f | map(.cost // 0) | add // 0 | . * 10000 | round / 10000)  tokens in/out: \($f | map(.tokens.input // 0) | add // 0)/\($f | map(.tokens.output // 0) | add // 0)"
    ' "$log" 2>/dev/null)"
    report="$(jq -rs 'map(select(.type == "text") | .part.text) | last // ""' "$log" 2>/dev/null)"
    if [ "${#report}" -gt "$max" ]; then
        report="${report:0:$max}
[truncated, ${#report} chars; full log below]"
    fi

    local check_out check_rc
    check_out="$(cd "$root" && bash -c "$check" 2>&1)"
    check_rc=$?

    echo "== executor =="
    echo "${summary:-session: none}"
    echo "executor exit: $exec_rc"
    [ "$exec_rc" -ne 0 ] && tail -n 5 "$log.stderr"
    echo "== executor report =="
    echo "$report"
    echo "== changes =="
    git -C "$root" status --short
    git -C "$root" diff --stat | tail -n 1
    echo "== check: $check =="
    echo "check exit: $check_rc"
    tail -n 40 <<<"$check_out"
    echo "log: $log"
    return "$check_rc"
}

case "${1:-}" in
    on) shift; cmd_on "$@" ;;
    model) shift; cmd_model "$@" ;;
    run) shift; cmd_run "$@" ;;
    off) cmd_off ;;
    status) cmd_status ;;
    hook) cmd_hook ;;
    *) usage ;;
esac
